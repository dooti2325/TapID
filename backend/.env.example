# TapID Backend — Environment Variables
# Copy this to .env and fill in your values

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # development | production | test

# ── MySQL Database ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_password_here
DB_NAME=tapid
DB_SSL=false                  # set to "true" for cloud-hosted databases (e.g. PlanetScale)

# ── JSON Web Token ────────────────────────────────────────────────────────────
# MUST be at least 32 characters in production
JWT_SECRET=change_me_to_a_very_long_random_secret_key_at_least_32_chars

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (in addition to localhost & *.vercel.app)
CORS_ORIGIN=https://yourdomain.com
